+static bool pdfAsciiAlpha(char c)
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z');
+}
+
+static size_t pdfSubtypeDigit(const std::string &text, size_t from)
+{
+    while ((from = text.find("PDF/", from)) != std::string::npos) {
+        size_t digit = from + 4;
+        if (text.compare(digit, 2, "A-") == 0 || text.compare(digit, 2, "X-") == 0 || text.compare(digit, 2, "E-") == 0) {
+            digit += 2;
+        } else if (text.compare(digit, 3, "VT-") == 0 || text.compare(digit, 3, "UA-") == 0) {
+            digit += 3;
+        } else {
+            from += 4;
+            continue;
+        }
+        if (digit < text.size() && text[digit] >= '0' && text[digit] <= '9') {
+            return digit;
+        }
+        from += 4;
+    }
+    return std::string::npos;
+}
