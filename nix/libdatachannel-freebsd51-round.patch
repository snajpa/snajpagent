-	return uint32_t(int64_t(round(seconds * double(clockRate)))); // convert to integer then cast to u32
+	const double v = seconds * double(clockRate);
+	return uint32_t(int64_t(v + (v >= 0 ? 0.5 : -0.5))); // round half away from zero
 }
 
