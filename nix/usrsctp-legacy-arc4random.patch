# SPDX-License-Identifier: BSD-3-Clause
# usrsctp: FreeBSD < 8 and NetBSD < 10 lack arc4random_buf; fill from the
# same PRNG via a distinctly named helper (no libc redeclaration risk).
--- a/usrsctplib/user_environment.c
+++ b/usrsctplib/user_environment.c
@@ -123,6 +123,27 @@
 #elif defined(__FreeBSD__) || defined(__DragonFly__) || defined(__OpenBSD__) || defined(__NetBSD__) || defined(__APPLE__) || defined(__Bitrig__)
 #include <stdlib.h>
 
+#if (defined(__FreeBSD__) && __FreeBSD_version < 800000) || (defined(__NetBSD__) && __NetBSD_Version__ < 1000000000)
+/* Legacy BSDs predate arc4random_buf; fill from the same PRNG. */
+#include <string.h>
+static void
+sctp_userspace_arc4random_buf(void *buf, size_t n)
+{
+	unsigned char *p = buf;
+
+	while (n >= 4) {
+		uint32_t v = arc4random();
+		memcpy(p, &v, 4);
+		p += 4;
+		n -= 4;
+	}
+	if (n > 0) {
+		uint32_t v = arc4random();
+		memcpy(p, &v, n);
+	}
+}
+#endif
+
 void
 init_random(void)
 {
@@ -132,7 +153,11 @@
 void
 read_random(void *buf, size_t size)
 {
+#if (defined(__FreeBSD__) && __FreeBSD_version < 800000) || (defined(__NetBSD__) && __NetBSD_Version__ < 1000000000)
+	sctp_userspace_arc4random_buf(buf, size);
+#else
 	arc4random_buf(buf, size);
+#endif
 	return;
 }
 
