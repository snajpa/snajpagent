Keep TLS 1.3 ticket notifications internal during blocked writes.
Mbed-TLS/mbedtls#10258 describes the duplicated record when a notification
flushes pending plaintext before curl retries the same write.

--- a/lib/vtls/mbedtls.c
+++ b/lib/vtls/mbedtls.c
@@ -819,10 +819,10 @@
   MBEDTLS_VERSION_NUMBER >= 0x03060100 &&   \
   MBEDTLS_VERSION_NUMBER < 0x04000000
-  /* New in mbedTLS 3.6.1, need to enable, default is now disabled. 4.0.0
-     enabled it by default for TLSv1.3. */
+  /* A ticket notification can flush a blocked write before returning.
+     Keep notifications internal so retries send each record once. */
   mbedtls_ssl_conf_tls13_enable_signal_new_session_tickets(
-    &backend->config, MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_ENABLED);
+    &backend->config, MBEDTLS_SSL_TLS1_3_SIGNAL_NEW_SESSION_TICKETS_DISABLED);
 #endif
 
   /* Always let mbedTLS verify certificates, if verifypeer or verifyhost are
