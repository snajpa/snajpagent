# usrsctp: FreeBSD < 12 lacks the libc timingsafe_bcmp; provide the userspace
# implementation there (the existing guard covers every other platform).
--- a/usrsctplib/netinet/sctp_os_userspace.h
+++ b/usrsctplib/netinet/sctp_os_userspace.h
@@ -1132,7 +1132,9 @@
 
