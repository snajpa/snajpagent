diff -ruN old/libc/sysdeps/linux/i386/bits/kernel_stat.h new/libc/sysdeps/linux/i386/bits/kernel_stat.h
--- old/libc/sysdeps/linux/i386/bits/kernel_stat.h	2025-09-19 01:14:04.000000000 +0200
+++ new/libc/sysdeps/linux/i386/bits/kernel_stat.h	2026-09-07 05:30:55.787600349 +0200
@@ -5,6 +5,12 @@
  * struct stat should look like...  It turns out each arch has a
  * different opinion on the subject... */
 
+/* Kernel timestamps retain the old long ABI even with 64-bit libc time_t. */
+struct kernel_timespec {
+	long tv_sec;
+	long tv_nsec;
+};
+
 struct kernel_stat {
 	unsigned long st_dev;
 	unsigned long st_ino;
@@ -17,9 +23,9 @@
 	unsigned long  st_size;
 	unsigned long  st_blksize;
 	unsigned long  st_blocks;
-	struct timespec st_atim;
-	struct timespec st_mtim;
-	struct timespec st_ctim;
+	struct kernel_timespec st_atim;
+	struct kernel_timespec st_mtim;
+	struct kernel_timespec st_ctim;
 	unsigned long  __uclibc_unused4;
 	unsigned long  __uclibc_unused5;
 };
@@ -33,17 +39,15 @@
 	unsigned int	st_nlink;
 	unsigned long	st_uid;
 	unsigned long	st_gid;
-	unsigned short	st_rdev;
-	unsigned char	__pad3[10];
+	unsigned long long st_rdev;
+	unsigned char	__pad3[4];
 	long long	st_size;
 	unsigned long	st_blksize;
-	unsigned long	st_blocks;	/* Number 512-byte blocks allocated. */
-	unsigned long	__pad4;		/* future possible st_blocks high bits */
-	struct timespec	st_atim;
-	struct timespec	st_mtim;
-	struct timespec	st_ctim;
+	unsigned long long st_blocks;	/* Number 512-byte blocks allocated. */
+	struct kernel_timespec st_atim;
+	struct kernel_timespec st_mtim;
+	struct kernel_timespec st_ctim;
 	unsigned long long	st_ino;
 };
 
 #endif	/*  _BITS_STAT_STRUCT_H */
