Preserve native statx and renameat2 with legacy i386 filesystem ABI fallbacks.

diff -ruN old/libc/sysdeps/linux/common/fstat.c new/libc/sysdeps/linux/common/fstat.c
--- old/libc/sysdeps/linux/common/fstat.c	2025-09-19 01:14:04.000000000 +0200
+++ new/libc/sysdeps/linux/common/fstat.c	2026-09-07 05:30:55.800600430 +0200
@@ -33,6 +33,7 @@
 #elif defined __NR_statx && defined __UCLIBC_HAVE_STATX__
 # include <fcntl.h>
 # include <statx_cp.h>
+# include <errno.h>
 
 int fstat(int fd, struct stat *buf)
 {
@@ -41,6 +42,14 @@
                                STATX_BASIC_STATS, &tmp);
       if (rc == 0)
         __cp_stat_statx ((struct stat *)buf, &tmp);
+# ifdef __NR_fstat64
+      else if (errno == ENOSYS) {
+        struct kernel_stat64 old;
+        rc = INLINE_SYSCALL(fstat64, 2, fd, &old);
+        if (rc == 0)
+          __xstat32_conv(&old, buf);
+      }
+# endif
 
       return rc;
 }
diff -ruN old/libc/sysdeps/linux/common/fstat64.c new/libc/sysdeps/linux/common/fstat64.c
--- old/libc/sysdeps/linux/common/fstat64.c	2025-09-19 01:14:04.000000000 +0200
+++ new/libc/sysdeps/linux/common/fstat64.c	2026-09-07 05:30:55.802600442 +0200
@@ -39,6 +39,8 @@
 #elif __NR_statx && defined __UCLIBC_HAVE_STATX__
 # include <fcntl.h>
 # include <statx_cp.h>
+# include <errno.h>
+# include "xstatconv.h"
 
 int fstat64(int fd, struct stat64 *buf)
 {
@@ -47,6 +49,14 @@
                                STATX_BASIC_STATS, &tmp);
       if (rc == 0)
         __cp_stat64_statx ((struct stat64 *)buf, &tmp);
+# ifdef __NR_fstat64
+      else if (errno == ENOSYS) {
+        struct kernel_stat64 old;
+        rc = INLINE_SYSCALL(fstat64, 2, fd, &old);
+        if (rc == 0)
+          __xstat64_conv(&old, buf);
+      }
+# endif
 
       return rc;
 }
diff -ruN old/libc/sysdeps/linux/common/fstatat.c new/libc/sysdeps/linux/common/fstatat.c
--- old/libc/sysdeps/linux/common/fstatat.c	2025-09-19 01:14:04.000000000 +0200
+++ new/libc/sysdeps/linux/common/fstatat.c	2026-09-07 05:30:55.805600460 +0200
@@ -35,6 +35,7 @@
 
 #if defined(__NR_statx) && defined __UCLIBC_HAVE_STATX__
 #include <sys/sysmacros.h> // for makedev
+#include <errno.h>
 
 int fstatat(int fd, const char *file, struct stat *buf, int flag)
 {
@@ -43,6 +44,15 @@
 
 	ret = INLINE_SYSCALL(statx, 5, fd, file, flag,
 			     STATX_BASIC_STATS, &tmp);
+# ifdef __NR_fstatat64
+	if (ret < 0 && errno == ENOSYS) {
+		struct kernel_stat64 old;
+		ret = INLINE_SYSCALL(fstatat64, 4, fd, file, &old, flag);
+		if (ret == 0)
+			__xstat32_conv(&old, buf);
+		return ret;
+	}
+# endif
 	if (ret != 0)
 		return ret;
 
diff -ruN old/libc/sysdeps/linux/common/fstatat64.c new/libc/sysdeps/linux/common/fstatat64.c
