diff -ruN old/libc/sysdeps/linux/common/rename.c new/libc/sysdeps/linux/common/rename.c
--- old/libc/sysdeps/linux/common/rename.c	2025-09-19 01:14:04.000000000 +0200
+++ new/libc/sysdeps/linux/common/rename.c	2026-09-07 06:05:24.492522021 +0200
@@ -9,6 +9,7 @@
 #include <sys/syscall.h>
 #include <stdio.h>
 #include <unistd.h>
+#include <errno.h>
 
 #if defined __NR_renameat && !defined __NR_rename
 # include <fcntl.h>
@@ -20,9 +21,12 @@
 # include <fcntl.h>
 int rename(const char *oldpath, const char *newpath)
 {
-	_syscall5(int, renameat2, int, olddfd, const char *, oldpath,
-		  int, newdfd, const char *, newpath, int, flags)
-	return renameat2(AT_FDCWD, oldpath, AT_FDCWD, newpath, 0);
+	int rc = INLINE_SYSCALL(renameat2, 5, AT_FDCWD, oldpath, AT_FDCWD, newpath, 0);
+# ifdef __NR_rename
+	if (rc < 0 && errno == ENOSYS)
+		rc = INLINE_SYSCALL(rename, 2, oldpath, newpath);
+# endif
+	return rc;
 }
 #else
 _syscall2(int, rename, const char *, oldpath, const char *, newpath)
