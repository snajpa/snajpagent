+static int win32_random_bytes(uint8_t *buf, size_t len)
+{
+    HCRYPTPROV provider;
+    BOOL generated, released;
+    if (len > UINT32_MAX)
+        return AVERROR_EXTERNAL;
+    if (!CryptAcquireContextA(&provider, NULL, NULL, PROV_RSA_FULL,
+                              CRYPT_VERIFYCONTEXT | CRYPT_SILENT))
+        return AVERROR_EXTERNAL;
+    generated = CryptGenRandom(provider, (DWORD)len, buf);
+    released = CryptReleaseContext(provider, 0);
+    return generated && released ? 0 : AVERROR_EXTERNAL;
+}
