# Preserve OSS3 default-device use when system headers lack OSS4 inventory APIs.
# Enumeration uses access checks only; capture/playback still require device init.
--- a/miniaudio.h
+++ b/miniaudio.h
@@ -38473,12 +38473,13 @@
         return ma_result_from_errno(errno);
     }
 
     return MA_SUCCESS;
 }
 
+#if defined(SNDCTL_SYSINFO) && defined(SNDCTL_AUDIOINFO)
 static ma_result ma_context_enumerate_devices__oss(ma_context* pContext, ma_enum_devices_callback_proc callback, void* pUserData)
 {
     int fd;
     oss_sysinfo si;
     int result;
 
@@ -38689,12 +38690,52 @@
         return MA_NO_DEVICE;
     }
 
     return MA_SUCCESS;
 }
 
+#else
+/* OSS3 has no device inventory ioctl. Report only the accessible default node;
+ * actual format/rate/direction negotiation stays in ma_device_init_fd__oss. */
+static ma_result ma_context_get_device_info__oss(ma_context* pContext, ma_device_type deviceType, const ma_device_id* pDeviceID, ma_device_info* pDeviceInfo)
+{
+    const char* name;
+    int mode;
+    (void)pContext;
+    if (deviceType != ma_device_type_playback && deviceType != ma_device_type_capture) {
+        return MA_INVALID_ARGS;
+    }
+    if (pDeviceID != NULL && strcmp(pDeviceID->oss, MA_OSS_DEFAULT_DEVICE_NAME) != 0) {
+        return MA_NO_DEVICE;
+    }
+    mode = deviceType == ma_device_type_playback ? W_OK : R_OK;
+    if (access(MA_OSS_DEFAULT_DEVICE_NAME, mode) != 0) {
+        return MA_NO_DEVICE;
+    }
+    name = deviceType == ma_device_type_playback ? MA_DEFAULT_PLAYBACK_DEVICE_NAME : MA_DEFAULT_CAPTURE_DEVICE_NAME;
+    MA_ZERO_OBJECT(pDeviceInfo);
+    ma_strncpy_s(pDeviceInfo->id.oss, sizeof(pDeviceInfo->id.oss), MA_OSS_DEFAULT_DEVICE_NAME, (size_t)-1);
+    ma_strncpy_s(pDeviceInfo->name, sizeof(pDeviceInfo->name), name, (size_t)-1);
+    pDeviceInfo->isDefault = MA_TRUE;
+    return MA_SUCCESS;
+}
+
+static ma_result ma_context_enumerate_devices__oss(ma_context* pContext, ma_enum_devices_callback_proc callback, void* pUserData)
+{
+    ma_device_info info;
+    if (ma_context_get_device_info__oss(pContext, ma_device_type_playback, NULL, &info) == MA_SUCCESS &&
+        !callback(pContext, ma_device_type_playback, &info, pUserData)) {
+        return MA_SUCCESS;
+    }
+    if (ma_context_get_device_info__oss(pContext, ma_device_type_capture, NULL, &info) == MA_SUCCESS) {
+        callback(pContext, ma_device_type_capture, &info, pUserData);
+    }
+    return MA_SUCCESS;
+}
+#endif
