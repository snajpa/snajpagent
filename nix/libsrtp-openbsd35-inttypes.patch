# SPDX-License-Identifier: BSD-3-Clause
# Supply the C99 format macros early OpenBSD inttypes.h omits (PRIx64 debug prints).
--- /dev/null
+++ b/compat/inttypes/inttypes.h
@@ -0,0 +1,11 @@
+/* SPDX-License-Identifier: BSD-3-Clause */
+/* Early OpenBSD inttypes.h supplies types but omits C99 format macros. */
+#ifndef LIBSRTP_COMPAT_INTTYPES_H
+#define LIBSRTP_COMPAT_INTTYPES_H
+
+#if defined(__OpenBSD__) && defined(__clang__) && !defined(PRIx64)
+/* PRIx64 covers the packet-index debug prints in srtp.c. */
+#define PRIx64 __UINT64_FMTx__
+#endif
+
+#endif /* LIBSRTP_COMPAT_INTTYPES_H */
--- a/srtp/srtp.c
+++ b/srtp/srtp.c
@@ -67,6 +67,8 @@
 #include <winsock2.h>
 #endif
 
+#include "../compat/inttypes/inttypes.h"
+
 /* the debug module for srtp */
 srtp_debug_module_t mod_srtp = {
     0,     /* debugging is off by default */
