# usrsctp: OpenBSD 3.5 lacks ENOTSUP (used in sctp_usrreq.c); the BSDs
# equate it with EOPNOTSUPP. Presence-gated.
--- a/usrsctplib/netinet/sctp_os_userspace.h
+++ b/usrsctplib/netinet/sctp_os_userspace.h
@@ -197,6 +197,11 @@
 #ifndef EHOSTUNREACH
 #define EHOSTUNREACH            WSAEHOSTUNREACH
 #endif
+/* OpenBSD 3.5 predates ENOTSUP; the BSDs equate it with EOPNOTSUPP. */
+#ifndef ENOTSUP
+#define ENOTSUP EOPNOTSUPP
+#endif
+
 #ifndef EPROCLIM
 #define EPROCLIM                WSAEPROCLIM
 #endif
