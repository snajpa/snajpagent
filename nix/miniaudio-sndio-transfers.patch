 }
 
 static ma_result ma_device_read__sndio(ma_device* pDevice, void* pPCMFrames, ma_uint32 frameCount, ma_uint32* pFramesRead)
 {
-    int result;
+    size_t bytesPerFrame = ma_get_bytes_per_frame(pDevice->capture.internalFormat, pDevice->capture.internalChannels);
