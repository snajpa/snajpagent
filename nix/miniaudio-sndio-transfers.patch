+    /* This backend opens sndio in blocking mode; a short write means failure. */
+    result = ((ma_sio_write_proc)pDevice->pContext->sndio.sio_write)((struct ma_sio_hdl*)pDevice->sndio.handlePlayback, pPCMFrames, bytesToWrite);
