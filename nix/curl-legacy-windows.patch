+++ b/lib/url.c
@@ -1477,6 +1477,23 @@
 }

 #ifdef USE_IPV6
+#if defined(_WIN32) && _WIN32_WINNT < 0x0600
+static unsigned int legacy_if_nametoindex(const char *name)
+{
+  typedef unsigned int (WINAPI *name_to_index)(const char *);
+  name_to_index query;
+  /* The required c-ares resolver imports this system library. */
+  HMODULE helper = GetModuleHandleW(L"iphlpapi.dll");
+  FARPROC function = helper ? GetProcAddress(helper, "if_nametoindex") : NULL;
+  if(!function) {
+    errno = ENODEV;
+    return 0;
+  }
+  memcpy(&query, &function, sizeof(query));
+  return query(name);
+}
+#define if_nametoindex legacy_if_nametoindex
+#endif
