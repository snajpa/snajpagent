Use handle-based NT5 file metadata for the legacy static libc++ variant.
Preserve timestamps, 64-bit sizes, file identities and reparse classification.

--- a/libcxx/src/filesystem/posix_compat.h
+++ b/libcxx/src/filesystem/posix_compat.h
@@ -145,39 +145,39 @@
 private:
   HANDLE h;
 };
 
