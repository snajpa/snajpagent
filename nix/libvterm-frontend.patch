+# SPDX-License-Identifier: GPL-2.0-only
+cmake_minimum_required(VERSION 3.16)
+project(snajpagent_vterm VERSION 0.3.3 LANGUAGES C)
+include(GNUInstallDirs)
+if(NOT SNAG_UNICODE_HEADER)
+  message(FATAL_ERROR "SNAG_UNICODE_HEADER must name the application's Unicode declaration header")
+endif()
+configure_file("${SNAG_UNICODE_HEADER}" snag_unicode.h COPYONLY)
+file(GLOB VTERM_SOURCES CONFIGURE_DEPENDS src/*.c)
+add_library(snajpagent-vterm STATIC ${VTERM_SOURCES})
+target_compile_features(snajpagent-vterm PRIVATE c_std_99)
+target_include_directories(snajpagent-vterm PRIVATE include "${CMAKE_CURRENT_BINARY_DIR}")
+set_target_properties(snajpagent-vterm PROPERTIES POSITION_INDEPENDENT_CODE ON)
+install(TARGETS snajpagent-vterm ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}")
+install(FILES include/vterm.h include/vterm_keycodes.h DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}")
+install(FILES LICENSE DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/snajpagent-vterm")
+configure_file(snajpagent-vterm.pc.in snajpagent-vterm.pc @ONLY)
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/snajpagent-vterm.pc"
+  DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig")
