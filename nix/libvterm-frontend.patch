+static void release_glyph(VTerm *vt, ScreenCell *cell)
+{
+  if(cell->glyph && !--cell->glyph->references)
+    vterm_allocator_free(vt, cell->glyph);
+  cell->glyph = NULL;
+}
+
+static void move_cells(VTerm *vt, ScreenCell *dest, const ScreenCell *src, size_t count)
+{
+  for(size_t i = 0; i < count; i++)
+    if(src[i].glyph)
+      src[i].glyph->references++;
+  /* Source and destination can overlap. Keep the retained source pointers
+   * intact until memmove has consumed them. */
+  for(size_t i = 0; i < count; i++)
+    if(dest[i].glyph && !--dest[i].glyph->references)
+      vterm_allocator_free(vt, dest[i].glyph);
+  memmove(dest, src, count * sizeof(*dest));
+}
