+#  if _WIN32_WINNT < 0x0501
+static ares_status_t ares_iface_ips_windows2000(ares_iface_ips_t *ips,
+                                                const char *name)
+{
+  ULONG size = sizeof(IP_ADAPTER_INFO), res = ERROR_BUFFER_OVERFLOW;
+  IP_ADAPTER_INFO *adapters = NULL, *adapter;
+  ares_status_t status = ARES_EFILE;
+  int tries;
+  for (tries = 0; tries < 3 && res == ERROR_BUFFER_OVERFLOW; tries++) {
+    IP_ADAPTER_INFO *next;
+    if (!size || size > 1024 * 1024)
+      goto done;
+    next = ares_realloc(adapters, size);
+    if (!next) {
+      status = ARES_ENOMEM;
+      goto done;
+    }
+    adapters = next;
+    res = GetAdaptersInfo(adapters, &size);
+  }
+  if (res == ERROR_NO_DATA) {
+    status = ARES_SUCCESS;
+    goto done;
+  }
+  if (res != ERROR_SUCCESS)
+    goto done;
+  status = ARES_SUCCESS;
+  for (adapter = adapters; adapter; adapter = adapter->Next) {
+    IP_ADDR_STRING *entry;
+    MIB_IFROW row;
+    ares_iface_ip_flags_t flags = 0;
+    if (!name_match(name, adapter->AdapterName, adapter->Index))
+      continue;
+    memset(&row, 0, sizeof(row));
+    row.dwIndex = adapter->Index;
+    if (GetIfEntry(&row) == NO_ERROR &&
+        row.dwOperStatus != MIB_IF_OPER_STATUS_OPERATIONAL)
+      flags |= ARES_IFACE_IP_OFFLINE;
+    if (adapter->Type == IF_TYPE_SOFTWARE_LOOPBACK)
+      flags |= ARES_IFACE_IP_LOOPBACK;
+    for (entry = &adapter->IpAddressList; entry; entry = entry->Next) {
+      struct ares_addr addr;
+      struct in_addr mask;
+      unsigned char prefix = 0;
+      size_t i;
+      addr.family = AF_INET;
+      if (ares_inet_pton(AF_INET, entry->IpAddress.String, &addr.addr.addr4) != 1 ||
+          addr.addr.addr4.s_addr == INADDR_ANY ||
+          ares_inet_pton(AF_INET, entry->IpMask.String, &mask) != 1)
+        continue;
+      for (i = 0; i < sizeof(mask); i++)
+        prefix = (unsigned char)(prefix + ares_count_bits_u8(((unsigned char *)&mask)[i]));
+      status = ares_iface_ips_add(ips, flags, adapter->AdapterName, &addr,
+                                   prefix, adapter->Index);
+      if (status != ARES_SUCCESS)
+        goto done;
+    }
+  }
+done:
+  ares_free(adapters);
+  return status;
+}
+#  endif
