--- a/src/lib/util/ares_rand.c
+++ b/src/lib/util/ares_rand.c
@@ -186,10 +186,33 @@
  * https://docs.microsoft.com/en-us/windows/win32/api/ntsecapi/nf-ntsecapi-rtlgenrandom
  */
 #ifdef _WIN32
+#  if _WIN32_WINNT < 0x0501
+#    include <wincrypt.h>
+static void ares_legacy_random(unsigned char *buf, size_t len)
+{
+  HCRYPTPROV provider = 0;
+  if (!CryptAcquireContextW(&provider, NULL, NULL, PROV_RSA_FULL,
+                             CRYPT_VERIFYCONTEXT | CRYPT_SILENT))
+    abort();
+  while (len) {
+    DWORD count = len > MAXDWORD ? MAXDWORD : (DWORD)len;
+    if (!CryptGenRandom(provider, count, buf)) {
+      CryptReleaseContext(provider, 0);
+      /* This void interface cannot propagate an entropy failure. */
+      abort();
+    }
+    buf += count;
+    len -= count;
+  }
+  if (!CryptReleaseContext(provider, 0))
+    abort();
+}
+#  else
 BOOLEAN WINAPI SystemFunction036(PVOID RandomBuffer, ULONG RandomBufferLength);
 #  ifndef RtlGenRandom
 #    define RtlGenRandom(a, b) SystemFunction036(a, b)
 #  endif
+#  endif
 #endif


