+    next = ares_realloc(info, size);
+    if (!next)
+      break;
+    info = next;
+    res = GetNetworkParams(info, &size);
+  }
+  if (res == ERROR_SUCCESS) {
+    IP_ADDR_STRING *dns;
+    for (dns = &info->DnsServerList; dns; dns = dns->Next) {
+      struct in_addr address;
+      if (ares_inet_pton(AF_INET, dns->IpAddress.String, &address) == 1 &&
+          address.s_addr != INADDR_ANY && address.s_addr != INADDR_NONE)
+        commajoin(outptr, dns->IpAddress.String);
+    }
+  }
+  ares_free(info);
+  return *outptr != NULL ? ARES_TRUE : ARES_FALSE;
+}
