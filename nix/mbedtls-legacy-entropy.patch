--- a/tests/suites/test_suite_platform_printf.function
+++ b/tests/suites/test_suite_platform_printf.function
@@ -140,0 +141,19 @@
+
+/* BEGIN_CASE depends_on:MBEDTLS_PLATFORM_HAS_NON_CONFORMING_SNPRINTF */
+void printf_truncated(int capacity)
+{
+    char output[16];
+    const char text[] = "0123456789";
+    memset(output, 'X', sizeof(output));
+    TEST_ASSERT(capacity >= 0 && capacity < 10);
+    TEST_EQUAL(mbedtls_snprintf(output, (size_t) capacity, "%s", text), -1);
+    TEST_EQUAL(output[capacity], 'X');
+    if (capacity) {
+        TEST_EQUAL(output[capacity - 1], 0);
+        TEST_MEMORY_COMPARE(output, (size_t) capacity - 1,
+                            text, (size_t) capacity - 1);
+    }
+exit:
+    return;
+}
+/* END_CASE */
