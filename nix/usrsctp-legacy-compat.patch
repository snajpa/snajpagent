# SPDX-License-Identifier: BSD-3-Clause
# usrsctp: legacy-POSIX compat fallbacks (POSIX branch, before the CMSG_ALIGN
# chain): __ALIGNBYTES/_ALIGN for NetBSD 2.x + OpenBSD 3.5, and ENOTSUP for
# OpenBSD 3.5. All presence-gated; values mirror the modern sysroots.
--- a/usrsctplib/netinet/sctp_os_userspace.h
+++ b/usrsctplib/netinet/sctp_os_userspace.h
@@ -1064,6 +1064,22 @@
 /* with the current included files, this is defined in Linux but
  *  in FreeBSD, it is behind a _KERNEL in sys/socket.h ...
  */
+/* Legacy SDKs (NetBSD 2.x, OpenBSD 3.5) lack these kernel alignment macros;
+   define them where the SDK does not (values mirror amd64/_types.h and
+   amd64/cdefs.h). */
+#ifndef __ALIGNBYTES
+#define __ALIGNBYTES (sizeof(long) - 1)
+#endif
+#ifndef _ALIGN
+#define _ALIGN(p) (((unsigned long)(p) + __ALIGNBYTES) & ~__ALIGNBYTES)
+#endif
+
+/* OpenBSD 3.5's errno.h predates ENOTSUP; the BSDs equate it with
+   EOPNOTSUPP. Presence-gated. */
+#ifndef ENOTSUP
+#define ENOTSUP EOPNOTSUPP
+#endif
+
 #if defined(__DragonFly__) || defined(__FreeBSD__) || defined(__OpenBSD__) || defined(__native_client__)
 /* stolen from /usr/include/sys/socket.h */
 #define CMSG_ALIGN(n)   _ALIGN(n)
